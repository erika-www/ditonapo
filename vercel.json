{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix passenger-app ci",
  "buildCommand": "npm --prefix passenger-app run build",
  "outputDirectory": "passenger-app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
